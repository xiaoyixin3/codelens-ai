NODE_ENV=development
# Set to production only in a managed deployment. Production mode rejects
# placeholder secrets, weak database credentials, and incomplete worker identity.
CODELENS_ENVIRONMENT=development
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgres://codelens:codelens@localhost:5432/codelens
REDIS_URL=redis://localhost:6379
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
# Optional complete image reference for production Compose. Leave blank when
# building locally; prefer the GHCR repo digest emitted by the release workflow.
CODELENS_IMAGE_REFERENCE=

GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=replace-with-a-high-entropy-secret
WEBHOOK_RATE_LIMIT_MAX=300
# Honor X-Forwarded-For only behind a trusted proxy that overwrites this header.
CODELENS_TRUST_PROXY=false
# Optional, but required for a full `npm run github:preflight` repository check.
GITHUB_TEST_OWNER=
GITHUB_TEST_REPO=

# Tunnel provider: cloudflare (default) or ngrok.
CODELENS_TUNNEL_PROVIDER=cloudflare

# Public HTTPS origin for a fixed tunnel. With Cloudflare, configure the token too.
# With ngrok, authenticate locally with `ngrok config add-authtoken` instead.
CODELENS_PUBLIC_BASE_URL=
CLOUDFLARE_TUNNEL_TOKEN=
NGROK_BIN=

# Optional OpenAI-compatible Chat Completions endpoint.
# Without these values, CodeLens uses the deterministic local summarizer.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
LLM_MAX_CALLS_PER_RUN=4
LLM_MAX_INPUT_CHARS_PER_RUN=250000

# Optional V2 model-connection control plane. Configure both values to enable
# the protected /api/v2/providers endpoints. Generate a random 32-byte key and
# store its standard base64 representation in CODELENS_CREDENTIAL_KEY.
CODELENS_MODEL_ADMIN_TOKEN=
CODELENS_CREDENTIAL_KEY=
CODELENS_ALLOW_PRIVATE_MODEL_ENDPOINTS=false

RETENTION_REVIEW_DAYS=90
RETENTION_SNAPSHOT_DAYS=30
RETENTION_WEBHOOK_DAYS=30
RETENTION_LLM_TELEMETRY_DAYS=90

MAX_CHANGED_FILES=100
MAX_PATCH_CHARS=120000
MAX_INDEX_FILE_BYTES=500000
MAX_INLINE_COMMENTS=8

# Phase 1 Java whole-repository semantics. Disabled by default. When enabled,
# the worker downloads authenticated archives at the PR's exact base/head SHAs,
# never executes repository code, and falls back explicitly if coverage fails.
CODELENS_SEMANTIC_ENABLED=false
# Comma-separated, case-insensitive owner/repository allowlist. The global switch
# alone never enables semantic processing for every installation.
CODELENS_SEMANTIC_REPOSITORIES=
CODELENS_SEMANTIC_WORKSPACE_ROOT=.codelens-workspaces/semantic
CODELENS_SEMANTIC_MAX_ARCHIVE_BYTES=536870912
CODELENS_SEMANTIC_MAX_EXTRACTED_BYTES=2147483648
CODELENS_SEMANTIC_MAX_ENTRIES=200000
CODELENS_SEMANTIC_MAX_FILES=50000
CODELENS_SEMANTIC_MAX_FILE_BYTES=2097152
# Optional read-only Maven-layout cache maintained by the operator. CodeLens never
# downloads dependencies and never executes Maven/Gradle while running at S1.
CODELENS_SEMANTIC_DEPENDENCY_CACHE=
CODELENS_SEMANTIC_MAX_DEPENDENCY_JARS=512
CODELENS_SEMANTIC_MAX_DEPENDENCY_JAR_BYTES=134217728

BENCHMARK_MIN_CASES=100
BENCHMARK_MIN_POSITIVE_CASES=20
BENCHMARK_MIN_NEGATIVE_CASES=20
BENCHMARK_MIN_PRECISION=0.8
BENCHMARK_MIN_RECALL=0.7
BENCHMARK_MAX_P95_MS=1000

BETA_OBSERVATION_DAYS=7
BETA_MIN_ELIGIBLE_REVIEWS=20
BETA_MIN_SUCCESS_RATE=0.95
