{
  "name": "codelens-ai",
  "version": "1.0.0-beta.1",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.17.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:api": "mvn -q -DskipTests package && java -Dcodelens.mode=api -jar target/codelens-ai.jar",
    "dev:worker": "mvn -q -DskipTests package && java -Dcodelens.mode=worker -jar target/codelens-ai.jar",
    "start:api": "java -Dcodelens.mode=api -jar target/codelens-ai.jar",
    "start:worker": "java -Dcodelens.mode=worker -jar target/codelens-ai.jar",
    "legacy:go:api": "go run ./cmd/api",
    "legacy:go:worker": "go run ./cmd/worker",
    "legacy:go:migrate": "go run ./cmd/migrate",
    "legacy:api": "tsx apps/api/src/main.ts",
    "legacy:worker": "tsx apps/worker/src/main.ts",
    "build": "mvn -q -DskipTests package",
    "build:legacy": "tsup",
    "typecheck": "tsc --noEmit",
    "security:scan": "node --import tsx scripts/scan-secrets.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark": "node --env-file-if-exists=.env --import tsx scripts/benchmark.ts",
    "benchmark:gate": "node --env-file-if-exists=.env --import tsx scripts/benchmark.ts --gate",
    "benchmark:collect": "node --env-file-if-exists=.env --import tsx scripts/collect-benchmark.ts",
    "benchmark:collect:go": "node --env-file-if-exists=.env --import tsx scripts/collect-benchmark.ts --languages=go --target=100 --output=benchmarks/candidates/go-public-prs.jsonl",
    "benchmark:collect:go-fixes": "node --env-file-if-exists=.env --import tsx scripts/collect-go-fix-benchmark.ts --target=30",
    "benchmark:collect-positive": "node --env-file-if-exists=.env --import tsx scripts/collect-positive-benchmark.ts",
    "benchmark:label": "node --env-file-if-exists=.env --import tsx scripts/benchmark-labeler.ts",
    "benchmark:label:go": "node --env-file-if-exists=.env --import tsx scripts/benchmark-labeler.ts --input=benchmarks/candidates/go-public-prs.jsonl --decisions=benchmarks/candidates/go-blind-review-decisions.json --output=benchmarks/candidates/go-blind-approved-replay.jsonl",
    "benchmark:label:go-fixes": "node --env-file-if-exists=.env --import tsx scripts/benchmark-labeler.ts --input=benchmarks/candidates/go-fix-reverse-curated.jsonl --decisions=benchmarks/candidates/go-fix-blind-review-decisions.json --output=benchmarks/candidates/go-fix-blind-approved-replay.jsonl",
    "beta:readiness": "node --env-file-if-exists=.env --import tsx scripts/beta-readiness.ts",
    "beta:local": "node --env-file-if-exists=.env --import tsx scripts/local-beta.ts",
    "smoke:pipeline": "node --env-file-if-exists=.env --import tsx scripts/smoke-pipeline.ts",
    "github:preflight": "node --env-file-if-exists=.env --import tsx scripts/github-preflight.ts",
    "db:migrate": "mvn -q -DskipTests package && java -Dcodelens.mode=migrate -jar target/codelens-ai.jar",
    "data:retain": "tsx scripts/retention.ts",
    "data:delete": "tsx scripts/delete-repository-data.ts",
    "release:check": "npm run security:scan && mvn -q test && npm run typecheck && npm test && npm run build && npm run build:legacy && tsx scripts/release-check.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.0",
    "bullmq": "^6.0.0",
    "fastify": "^5.0.0",
    "ioredis": "^5.11.1",
    "minimatch": "^10.2.6",
    "octokit": "^5.0.0",
    "postgres": "^3.4.0",
    "typescript": "^5.9.0",
    "yaml": "^2.9.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsup": "^8.5.0",
    "tsx": "^4.0.0",
    "vitest": "^3.0.0"
  }
}
