version: 1

review:
  language: en
  blocking: false
  maxInlineComments: 8
  minimumConfidence:
    critical: 0.85
    high: 0.85
    medium: 0.80

include:
  - "src/**/*.go"
  - "src/**/*.java"
  - "src/**/*.kt"
  - "src/**/*.py"
  - "src/**/*.ts"
  - "src/**/*.tsx"
  - "src/**/*.js"
  - "src/**/*.jsx"
  - "src/**/*.cs"
  - "src/**/*.c"
  - "src/**/*.cpp"
  - "src/**/*.h"
  - "src/**/*.hpp"
  - "src/**/*.rs"
  - "src/**/*.php"
  - "src/**/*.rb"
  - "src/**/*.swift"

exclude:
  - "**/*.generated.*"
  - "**/dist/**"
  - "**/vendor/**"

rules:
  - key: payment-idempotency
    content: "Payment writes must use an idempotency key."
    scope: "src/payment/**"
    severity: high
    enabled: true
